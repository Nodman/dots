#!/usr/bin/env python3
"""Run a command in a pty; unwrap tmux-passthrough DCS (ESC Ptmux; ... ESC \\)
from its output so terminals that don't speak it (nvim :terminal) get the
raw inner sequence instead of leaked garbage. Usage: pty-tmux-unwrap CMD [ARGS...]"""
import fcntl
import os
import pty
import select
import signal
import struct
import sys
import termios
import tty

START = b"\x1bPtmux;"
END = b"\x1b\\"

buf = b""


def unwrap(data):
    """Return (output, keep) - filtered bytes to emit and tail to buffer."""
    global buf
    buf += data
    out = bytearray()
    while True:
        i = buf.find(START)
        if i == -1:
            # emit all but a possible partial START at the tail
            keep = 0
            for k in range(1, len(START)):
                if buf.endswith(START[:k]):
                    keep = k
            cut = len(buf) - keep
            out += buf[:cut]
            buf = buf[cut:]
            return bytes(out)
        out += buf[:i]
        j = buf.find(END, i + len(START))
        if j == -1:
            if len(buf) - i > 1 << 20:  # runaway guard: not a real wrapper
                out += buf[i:]
                buf = b""
                return bytes(out)
            buf = buf[i:]
            return bytes(out)
        payload = buf[i + len(START) : j]
        out += payload.replace(b"\x1b\x1b", b"\x1b")
        buf = buf[j + len(END) :]


def main():
    if len(sys.argv) < 2:
        sys.stderr.write("usage: pty-tmux-unwrap CMD [ARGS...]\n")
        return 2

    pid, master = pty.fork()
    if pid == 0:
        os.execvp(sys.argv[1], sys.argv[1:])

    stdin_fd = sys.stdin.fileno()
    stdout_fd = sys.stdout.fileno()

    def sync_winsize(*_):
        try:
            ws = fcntl.ioctl(stdin_fd, termios.TIOCGWINSZ, b"\0" * 8)
            fcntl.ioctl(master, termios.TIOCSWINSZ, ws)
        except OSError:
            pass

    signal.signal(signal.SIGWINCH, sync_winsize)
    sync_winsize()

    tty_attrs = None
    try:
        tty_attrs = termios.tcgetattr(stdin_fd)
        tty.setraw(stdin_fd)
    except termios.error:
        pass

    try:
        while True:
            try:
                r, _, _ = select.select([stdin_fd, master], [], [])
            except InterruptedError:
                continue
            if master in r:
                try:
                    data = os.read(master, 65536)
                except OSError:  # EIO: child exited
                    break
                if not data:
                    break
                os.write(stdout_fd, unwrap(data))
            if stdin_fd in r:
                data = os.read(stdin_fd, 65536)
                if not data:
                    os.close(master)
                    break
                os.write(master, data)
    finally:
        if tty_attrs is not None:
            termios.tcsetattr(stdin_fd, termios.TCSAFLUSH, tty_attrs)
        if buf:
            os.write(stdout_fd, buf)

    _, status = os.waitpid(pid, 0)
    return os.waitstatus_to_exitcode(status) if status >= 0 else 1


if __name__ == "__main__":
    sys.exit(main())
